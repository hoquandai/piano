<!-- Add your own nav links here. Below are links to the default admin-based pages installed with Rails UI. -->
<% Railsui::Pages.installed_pages.each do |page, details| %>
  <% if respond_to?(details['path'].to_sym) && details['add_to_nav'] && details['namespace'] == 'admin' %>
    <%= content_tag :li do %>
      <%= nav_link_to details['title'], send(details['path'].to_sym), class: "rui-nav-link--admin" %>
    <% end %>
    <% if page.to_s == "dashboard" %>
      <%= content_tag :li do %>
        <%= nav_link_to "Tools", rui_tools_path, class: "rui-nav-link--admin" %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
